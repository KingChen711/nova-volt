{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Nvm.BusProbe": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    "Nvm.BusProbe (failing consumer on)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "NVM_BUS_PROBE_CONSUMERS": "cache,audit,failing"
      }
    },
    "Nvm.BusProbe (cache only)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "NVM_BUS_PROBE_CONSUMERS": "cache"
      }
    }
  }
}
