{
  "Name": "Production_007_FinishedGoodsMaterials",
  "BreakOnError": true,
  "TestDefinitions": [
    {
      "Name": "CreateMaterial",
      "Csv": "finished-goods-materials.csv",
      "TestSteps": [
        {
          "ID": "GetMaterial",
          "StepType": "Read",
          "App": "Production",
          "Name": "Material",
          "Query": {
            "$filter": "NId eq '#TEST_CSV.NId#'",
            "$top": "1"
          },
          "IfThisSkipNext": true
        },
        {
          "ID": "CreateMaterial",
          "StepType": "Command",
          "App": "Production",
          "Name": "CreateMaterial",
          "Parameters": {
            "NId": "#TEST_CSV.NId#",
            "Name": "#TEST_CSV.Name#",
            "UnitOfMeasure": "#TEST_CSV.UnitOfMeasure#",
            "Serialized": "#TEST_CSV.Serialized#",
            "MaterialClass": "#TEST_CSV.MaterialClass#"
          }
        }
      ]
    }
  ]
}
