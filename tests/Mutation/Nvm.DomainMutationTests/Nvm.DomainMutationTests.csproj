<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chỉ để chạy mutation test (Stryker.NET, M13). Stryker 5.0 chưa hỗ trợ Microsoft.Testing.Platform
    (stryker-net#3094); và với xunit v3 qua VSTest, test chạy trong process con nên Stryker không bật được mutant
    (thử 2026-09-27: 0 mutant bị giết dù assembly đột biến đã vào đúng thư mục). Vì vậy project này biên dịch lại các unit
    test của domain trên xunit v2 (chạy trong process), với shim TestContext.
    Không nằm trong NovaVolt.Mes.slnx: solution chạy test bằng MTP (global.json) và không trộn được hai runner.
    Chạy: tools/mutation/run-mutation.sh
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>Nvm.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Compile Include="../../Unit/Nvm.UnitTests/Quality/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Grading/**/*.cs" Exclude="../../Unit/Nvm.UnitTests/Grading/MatchingTests.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Equipment/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Passport/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Traceability/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Material/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/ProductionExecution/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/Recipe/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/MasterData/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/FactoryModel/**/*.cs" />
    <Compile Include="../../Unit/Nvm.UnitTests/TestSupport/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Platform/Nvm.Contracts/Nvm.Contracts.csproj" />
    <ProjectReference Include="../../../src/Platform/Nvm.Kernel/Nvm.Kernel.csproj" />
    <ProjectReference Include="../../../src/Platform/Nvm.EventStore/Nvm.EventStore.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Quality/Nvm.Quality.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Grading/Nvm.Grading.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Equipment/Nvm.Equipment.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Passport/Nvm.Passport.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Traceability/Nvm.Traceability.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Material/Nvm.Material.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/ProductionExecution/Nvm.ProductionExecution.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/Recipe/Nvm.Recipe.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/MasterData/Nvm.MasterData.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/FactoryModel/Nvm.FactoryModel.csproj" />
  </ItemGroup>

</Project>
