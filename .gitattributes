# Chuẩn hoá line ending. Repo lưu LF, checkout theo nhu cầu từng loại file.
# Kèm `git config core.autocrlf false` để Git không tự ý đổi sau lưng .gitattributes.
* text=auto eol=lf

# Script phải giữ đúng line ending của nền tảng chạy nó
*.sh    text eol=lf
*.bash  text eol=lf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Makefile bắt buộc dùng TAB — đừng để editor đổi thành space
Makefile      text eol=lf
makefile      text eol=lf
*.mk          text eol=lf

# .NET
*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.props     text
*.targets   text

# Cấu hình
*.json  text
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.md    text
*.xml   text

# Mendix — model là nhị phân, không bao giờ merge bằng text diff
*.mpr   binary
*.mpk   binary
*.mxunit binary

# Nhị phân khác
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.bundle binary

# Không tính vào thống kê ngôn ngữ của repo
docs/**    linguist-documentation
