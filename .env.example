# NovaVolt MOM v2 — cấu hình local
#
# Copy thành .env rồi ĐIỀN mật khẩu:   cp .env.example .env
# .env bị gitignore. File này KHÔNG được chứa secret thật (AGENTS.md K13).
#
# Mọi `CHANGE_ME_*` phải tự đặt trước khi `make up`; `make secret-check` từ chối nếu quên,
# và từ chối cả giá trị đã từng bị commit (scripts/burned-credentials.sha256).

# ─────────────────────────────────────────────────────────
# Bảng port — một chỗ duy nhất
# ─────────────────────────────────────────────────────────
NVM_PORT_MSSQL=1433
NVM_PORT_RABBITMQ=5672
NVM_PORT_RABBITMQ_UI=15672
NVM_PORT_KEYCLOAK=8081
NVM_PORT_LINEDB=5432
NVM_PORT_KAFKA=19092
# Không dùng 1025: Windows có thể đặt dải cổng động từ 1024, khi đó 1025 thuộc tiến trình hệ thống.
NVM_PORT_SMTP=25025
NVM_PORT_MAIL_UI=8025

# Host .NET chạy ngoài Docker (dotnet run), và web Next.js; ghi ở đây cho đủ bảng
NVM_PORT_MOM=5080
# Không dùng 3000-3019: Windows có thể giữ riêng dải này (netsh int ipv4 show excludedportrange protocol=tcp).
NVM_PORT_WEB=3100

# ─────────────────────────────────────────────────────────
# SQL Server — DB MOM của plant
# Mật khẩu phải đạt độ phức tạp của SQL Server: >= 8 ký tự, có hoa, thường, số, ký tự đặc biệt.
# ─────────────────────────────────────────────────────────
NVM_MSSQL_SA_PASSWORD=CHANGE_ME_Sa1!
NVM_MSSQL_APP_PASSWORD=CHANGE_ME_App1!

# ─────────────────────────────────────────────────────────
# RabbitMQ — bus event của Foundation
# ─────────────────────────────────────────────────────────
NVM_RABBITMQ_USER=nvm
NVM_RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq

# ─────────────────────────────────────────────────────────
# Keycloak
# ─────────────────────────────────────────────────────────
NVM_KEYCLOAK_ADMIN=admin
NVM_KEYCLOAK_PASSWORD=CHANGE_ME_keycloak
# Mật khẩu chung của user thử trong realm novavolt; đặt bằng scripts/keycloak-demo-users.py, không nằm trong realm JSON.
NVM_DEMO_USER_PASSWORD=CHANGE_ME_Demo1!

# ─────────────────────────────────────────────────────────
# LineDB — Postgres phía xưởng
# ─────────────────────────────────────────────────────────
NVM_LINEDB_DB=linedb
NVM_LINEDB_USER=linedb
NVM_LINEDB_PASSWORD=CHANGE_ME_linedb

# ─────────────────────────────────────────────────────────
# Backup — `make backup` git-bundle toàn bộ repo kèm lịch sử vào đây
# ─────────────────────────────────────────────────────────
NVM_BACKUP_DIR=
