<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nvm.Kernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Abstractions only. Đủ để AddNvmKernel khai báo IServiceCollection; KHÔNG kéo theo một
      container. CommandDispatcher chỉ nhận System.IServiceProvider của BCL.
      Ranh giới này được ép bằng NetArchTest ở C17 (rule A2).
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts chỉ có BCL (A1), nên chiều Kernel → Contracts không tạo vòng. -->
    <ProjectReference Include="../Nvm.Contracts/Nvm.Contracts.csproj" />
  </ItemGroup>

</Project>
