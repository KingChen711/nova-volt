<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ép ranh giới giữa các lớp v2 (AGENTS.md K8) bằng đồ thị ProjectReference.
    Đọc .csproj thay vì metadata assembly: compiler bỏ reference không dùng tới khỏi metadata,
    nên một reference sai chiều mà chưa dùng type nào sẽ lọt qua phép kiểm dựa trên assembly.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nvm.ArchitectureTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
