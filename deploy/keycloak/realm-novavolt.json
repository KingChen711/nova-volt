      { "name": "line-lead", "description": "Trưởng ca: giữ hàng, hủy lệnh đóng băng" },
      { "name": "quality", "description": "Chất lượng: NC hàng loạt, kết luận NC, containment, tháo rã" },
      { "name": "yard", "description": "Cổng và dock: đăng ký xe, kéo xe, nhận skid" },
      { "name": "shipping", "description": "Thành phẩm: cất kho, picking, staging, chất xe" },
      { "name": "logistics", "description": "Hậu cần nội bộ: kanban, gọi hàng, bảng gọi hàng" }
    ]
  },
  "clients": [
