<Project>

  <!--
    Central Package Management.
    Version của package khai báo DUY NHẤT ở đây; file .csproj chỉ ghi
    <PackageReference Include="..." /> không kèm Version.

    Vì sao: 20 project mà mỗi project tự chọn version là công thức cho
    "nó chạy trên máy tôi". Ở đây đổi một dòng là cả repo đổi theo.

    Quy tắc thêm package mới:
      1. Thêm dòng PackageVersion vào đúng nhóm bên dưới
      2. Ghi một chú thích ngắn: dùng ở milestone nào, để làm gì
      3. Nếu package thay thế một lựa chọn hiển nhiên hơn → ghi ADR
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Hosting và logging — C03 trở đi">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Health check — C10 trở đi">
    <!--
      Uris dùng cho Keycloak, MinIO VÀ RabbitMQ. Với RabbitMQ, endpoint quản trị
      /api/health/checks/alarms nói được điều mà một lần TCP connect không nói được:
      broker còn sống nhưng đã chặn publisher vì alarm bộ nhớ/đĩa.
    -->
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Manufacturing Service Bus — C09 trở đi">
    <!--
      PIN CỨNG v8. KHÔNG nâng lên 9.x.

      MassTransit 9 đã chuyển sang license THƯƠNG MẠI. Kiểm 2026-08-26:
        masstransit 9.2.0  → <licenseUrl>https://massient.com/license</licenseUrl>
        masstransit 8.5.10 → <license type="expression">Apache-2.0</license>
      §3 của license đó nói rõ: v8 trở về trước vẫn free/open source nhưng KHÔNG được hỗ trợ
      theo thoả thuận; thoả thuận chỉ áp dụng cho v9 trở lên.

      8.5.10 có nhóm targetFramework net10.0 và kéo RabbitMQ.Client 7.2.1 — tương thích
      RabbitMQ 4.3.5 đang chạy trong compose. Xem ADR-021.

      Quyết định này được ép bằng test (MassTransitPinTests), không chỉ bằng comment này:
      nâng major sẽ làm test đỏ và trỏ thẳng về ADR-021.

      Bài học lặp lại lần thứ hai trong repo (lần đầu: FluentAssertions v8 ở M0/C04):
      KIỂM LICENSE trước khi pin version, không chỉ kiểm nó có chạy không.
    -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup Label="Sparkplug B / protobuf — M2/C01 trở đi">
    <!--
      HAI GÓI, HAI VAI TRÒ. Google.Protobuf là runtime (app nạp lúc chạy); Grpc.Tools chỉ là
      build-time — nó mang theo protoc.exe và móc vào MSBuild để sinh C# từ .proto.

      LICENSE, kiểm 2026-08-28 trước khi pin (§2.2 của plan M2, cùng quy trình đã dùng cho
      MassTransit ở M1/C09):
        google.protobuf 3.35.1 → <license type="expression">BSD-3-Clause</license>
        grpc.tools      2.83.0 → <license type="expression">Apache-2.0</license>
      Cả hai permissive, không có bẫy như FluentAssertions v8 hay MassTransit v9.

      VÌ SAO 3.35.1 CHỨ KHÔNG PHẢI 3.36.0 (bản stable mới nhất lúc pin) — cùng loại lý do với
      Microsoft.CodeAnalysis ở dưới: pin theo thứ TOOLCHAIN ĐANG SHIP, không pin theo "mới nhất".

      Đo ngày 2026-08-28:
        tools/windows_x64/protoc.exe trong grpc.tools 2.83.0  → `libprotoc 35.1`
        nuspec google.protobuf 3.35.1 → repository commit 35cd01f9fe9afbeea38cc7b979a3b6bfcde82c03
        protobuf tag v35.1            → cùng commit 35cd01f9fe9afbeea38cc7b979a3b6bfcde82c03
      Tức runtime 3.35.1 và protoc 35.1 build ra từ ĐÚNG một commit. Không còn chiều nào để
      phải suy luận.

      Quy tắc chung nếu sau này lệch: runtime phải >= protoc, không bao giờ thấp hơn. Code do
      protoc mới sinh ra có thể gọi API mà runtime cũ chưa có; chiều ngược lại thì an toàn.

      KHÔNG nâng lên 4.0.0-rc*: prerelease.
    -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
  </ItemGroup>

  <ItemGroup Label="MQTT — M2/C05 trở đi">
    <!--
      Client MQTT cho simulator (C05) và edge gateway (C08). KHÔNG decode Sparkplug — payload là
      protobuf, và đó là việc của Nvm.Sparkplug (ADR-026).

      LICENSE, kiểm 2026-08-28 trước khi pin: nuspec ghi <license type="file">LICENSE</license>,
      và file LICENSE trong gói là **MIT** ("The MIT License (MIT) — Copyright (c) .NET Foundation
      and Contributors"). projectUrl là github.com/dotnet/MQTTnet. Không có bẫy như MassTransit v9.

      5.2.0.1603 có nhóm targetFramework net10.0 và **không phụ thuộc package nào** — nên không có
      version nào bị nâng ngầm qua đường transitive.
    -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup Label="PostgreSQL ingestion — M2/C12 trở đi">
    <!--
      Npgsql là driver runtime; dbup-postgresql chỉ chạy trong migration job riêng và trong
      integration test. App phục vụ HTTP KHÔNG tự migrate lúc startup (scope.md §8.4).

      LICENSE, kiểm 2026-08-28 trước khi pin:
        Npgsql                    10.0.3  → PostgreSQL License
        dbup-postgresql            7.0.1  → MIT
        Testcontainers.PostgreSql  4.14.0 → MIT
      Cả ba có asset tương thích net10.0; Testcontainers chỉ xuất hiện trong test.
    -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core test host — M2/C10">
    <!--
      TestHost dựng pipeline thật trong process, không mở socket. Cần để kiểm hợp đồng
      backpressure của ingestion (429 + Retry-After) mà không phải bật container.

      LICENSE, kiểm 2026-08-28: Microsoft.AspNetCore.TestHost 10.0.3 → MIT.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Dependency injection — C04 trở đi">
    <!--
      CHỈ Abstractions, không phải gói DI đầy đủ. Nvm.Kernel cần IServiceCollection để đăng ký
      handler; nó KHÔNG cần một container. Bản cài đặt dispatcher chỉ dùng System.IServiceProvider
      của BCL, nên tầng domain vẫn sạch theo K9.

      Gói đầy đủ (Microsoft.Extensions.DependencyInjection) chỉ xuất hiện ở test và ở host —
      những nơi thật sự dựng container.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Thời gian — nền cho K1 (cấm DateTime.UtcNow), dùng nhiều từ M7 (saga)">
    <!-- FakeTimeProvider: tua 12 ngày trong 1 test. Xem scope.md §2.4 compressed clock -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup Label="Roslyn analyzer — C15 trở đi">
    <!--
      PIN THEO SDK, KHÔNG PIN THEO "MỚI NHẤT".

      Analyzer được COMPILER nạp chứ không phải app nạp. Build analyzer dựa trên Roslyn mới
      hơn compiler đang chạy thì compiler không tạo được instance, ném AD0001 / CS8032 —
      và triệu chứng bên ngoài là ANALYZER IM LẶNG, build vẫn xanh. Không phải một lỗi rõ ràng.

      Quy tắc: version của Microsoft.CodeAnalysis.* phải <= Roslyn trong SDK THẤP NHẤT mà
      repo hỗ trợ. global.json pin SDK 10.0.300, nên hai con số này gắn với nhau — đổi
      global.json thì phải đo lại dòng dưới đây.

      Đo ngày 2026-08-27, SDK 10.0.300 ship Roslyn 5.6.0:

        Doc ProductVersion cua file nay trong SDK dang dung (dotnet SDK path):
        <dotnet-root>\sdk\<version>\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll
        → 5.6.0-2.26230.102

      Bản stable mới nhất trên NuGet lúc đó là 5.9.0. KHÔNG nâng lên.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!--
      Hạ tầng test cho analyzer. CỐ Ý dùng gói KHÔNG có hậu tố .XUnit.

      Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit kéo theo
      Microsoft.CodeAnalysis.Testing.Verifiers.XUnit — hạ tầng xunit v2, trong khi repo này
      chỉ có xunit v3 (M0/C04.1). Gói không hậu tố dùng DefaultVerifier và không phụ thuộc
      xunit ở bất kỳ version nào (đã kiểm nuspec 1.1.4: chỉ Analyzer.Testing +
      CSharp.Workspaces + System.Formats.Asn1).
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Analyzer.Testing khai CSharp.Workspaces >= 1.0.1; pin cùng Roslyn của SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Architecture test — C17 trở đi">
    <!--
      NetArchTest.Rules đọc IL của assembly ĐÃ BUILD qua Mono.Cecil, nên nó bắt được thứ mà
      analyzer không bắt được: `#pragma warning disable` giấu được diagnostic lúc biên dịch,
      nhưng không xoá được dependency khỏi metadata.

      1.3.2 là bản cuối (2021), netstandard2.0. Cũ nhưng không phải bỏ hoang theo nghĩa xấu:
      nó đọc ECMA-335, thứ không đổi giữa các bản .NET. Đã kiểm chạy được với assembly net10.0
      ngày 2026-08-27 — nếu bản .NET nào đó về sau làm nó vỡ thì cả sáu rule chuyển sang
      reflection thuần, mỗi rule mất vài dòng.
    -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup Label="Test — C04 trở đi">
    <!--
      Chỉ xunit.v3. KHÔNG có Microsoft.NET.Test.Sdk, KHÔNG có xunit.runner.visualstudio:
      cả hai là hạ tầng VSTest, mà .NET 10 đã bỏ hỗ trợ VSTest cho Microsoft.Testing.Platform.
      xunit.v3 nhúng sẵn MTP runner; bật MTP mode ở global.json.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!--
      Shouldly chứ KHÔNG phải FluentAssertions.
      FluentAssertions từ v8 chuyển sang license thương mại cho mục đích thương mại.
      Project này là học tập nên vẫn dùng được, nhưng tránh tạo thói quen sai
      trước khi vào dự án thật. Xem scope.md §10.1.
    -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
