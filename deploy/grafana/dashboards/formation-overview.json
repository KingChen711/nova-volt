      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "novavolt-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH hours AS (\n  SELECT generate_series(\n    date_trunc('hour', $__timeFrom()::timestamptz),\n    date_trunc('hour', $__timeTo()::timestamptz),\n    INTERVAL '1 hour') AS time\n), bad AS (\n  SELECT time_bucket(INTERVAL '1 hour', device_timestamp) AS time, count(*)::double precision AS row_count\n  FROM ts_scoped.telemetry_measurement\n  WHERE site_id = ${site:sqlstring}\n    AND clock_quality <> 'Good'\n    AND $__timeFilter(device_timestamp)\n  GROUP BY 1\n)\nSELECT hours.time, coalesce(bad.row_count, 0)::double precision AS \"Non-good clock rows\"\nFROM hours\nLEFT JOIN bad USING (time)\nORDER BY hours.time;",
          "refId": "A"
        }
      ],
      "title": "Clock-quality warning rows per hour",
      "type": "timeseries"
    }
