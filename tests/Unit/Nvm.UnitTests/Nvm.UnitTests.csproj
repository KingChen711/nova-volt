<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 test projects are executables; the runner is compiled into the assembly. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Nvm.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Chỉ cần xunit.v3: nó đã nhúng sẵn Microsoft.Testing.Platform runner.
      KHÔNG thêm Microsoft.NET.Test.Sdk hay xunit.runner.visualstudio — đó là hạ tầng
      VSTest, và .NET 10 đã bỏ hỗ trợ VSTest cho MTP. Xem dotnet.config ở thư mục gốc.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!--
      Container thật để kiểm AddNvmKernel và dispatcher. Nvm.Kernel chỉ tham chiếu Abstractions;
      chỗ duy nhất cần một container là test và host.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- FakeTimeProvider: tua đồng hồ trong test thay vì chờ thật. Nền cho K1, dùng nhiều từ M7. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Platform/Nvm.Contracts/Nvm.Contracts.csproj" />
    <ProjectReference Include="../../../src/Platform/Nvm.Kernel/Nvm.Kernel.csproj" />
    <ProjectReference Include="../../../src/FunctionalBlocks/FactoryModel/Nvm.FactoryModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Seed thật, không phải fixture rút gọn. Test đọc đúng file mà hệ thống sẽ đọc, nên sửa
      seed sẽ làm test đếm node đỏ — đó là hành vi đúng (deploy/seed/README.md).
    -->
    <Content Include="../../../deploy/seed/**/*.json" LinkBase="seed" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
