      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "novavolt-timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket AS time, replace(signal_code, 'Formation/', '') AS metric, avg_value::double precision AS value\nFROM ts_scoped.process_signal_1m\nWHERE site_id = ${site:sqlstring}\n  AND equipment_id = ${equipment:sqlstring}\n  AND signal_code IN ('Formation/Voltage', 'Formation/Current')\n  AND $__timeFilter(bucket)\n  AND ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) > INTERVAL '6 hours'\nUNION ALL\nSELECT device_timestamp AS time, replace(signal_code, 'Formation/', '') AS metric, real_value::double precision AS value\nFROM ts_scoped.telemetry_measurement\nWHERE site_id = ${site:sqlstring}\n  AND equipment_id = ${equipment:sqlstring}\n  AND signal_code IN ('Formation/Voltage', 'Formation/Current')\n  AND value_kind = 'real'\n  AND $__timeFilter(device_timestamp)\n  AND ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) <= INTERVAL '6 hours'\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Formation curve — CC → CV",
      "type": "timeseries"
    },
