          "rawSql": "SELECT bucket AS time, avg_value::double precision AS \"Temperature\"\nFROM ts_scoped.process_signal_1m\nWHERE site_id = ${site:sqlstring}\n  AND equipment_id = ${equipment:sqlstring}\n  AND signal_code = 'Formation/Temperature'\n  AND $__timeFilter(bucket)\n  AND ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) > INTERVAL '6 hours'\nUNION ALL\nSELECT device_timestamp AS time, real_value::double precision AS \"Temperature\"\nFROM ts_scoped.telemetry_measurement\nWHERE site_id = ${site:sqlstring}\n  AND equipment_id = ${equipment:sqlstring}\n  AND signal_code = 'Formation/Temperature'\n  AND value_kind = 'real'\n  AND $__timeFilter(device_timestamp)\n  AND ($__timeTo()::timestamptz - $__timeFrom()::timestamptz) <= INTERVAL '6 hours'\nORDER BY 1;",
