# NovaVolt MES — cấu hình local
#
# Copy thành .env rồi ĐIỀN mật khẩu:   cp .env.example .env
# .env bị gitignore. File này KHÔNG được chứa secret thật (AGENTS.md K13).
#
# Port và tên database là giá trị dùng được luôn. Mọi `CHANGE_ME_*` thì KHÔNG —
# phải tự đặt trước khi `make up`, và `make secret-check` sẽ từ chối nếu quên.
#
# Vì sao không để sẵn mật khẩu "dev-only" như trước: file này được commit, nên
# mật khẩu trong nó là mật khẩu công khai — và audit M3 đo được rằng stack thật
# đang chạy bằng đúng chúng, với port khi đó còn bind 0.0.0.0. "Dev-only" là một
# lời hứa về ý định; nó không phải một ràng buộc. Xem ADR-034 §O8.
#
# Chín giá trị cũ đã nằm vĩnh viễn trong lịch sử git và không rút lại được, nên
# hash của chúng nằm ở scripts/burned-credentials.sha256 và secret-check từ chối
# bất kỳ .env nào còn dùng lại một trong số đó.

# ─────────────────────────────────────────────────────────
# Bảng port — một chỗ duy nhất
#
# Đây là bảng quyết định, không phải config thừa: R-M0-5 trong plan đã cảnh báo
# Keycloak và Mendix Studio Pro đụng nhau ở 8080. Chốt ngay bây giờ để C09 và C13
# khỏi phải sửa chéo: Mendix giữ 8080 (đổi nó phiền hơn), Keycloak nhường sang 8081.
#
# Được tiêu thụ dần: C06 Postgres · C07 SQL Server · C08 RabbitMQ+EMQX · C09 MinIO+Keycloak
# ─────────────────────────────────────────────────────────
NVM_PORT_POSTGRES=5432
NVM_PORT_MSSQL=1433
NVM_PORT_RABBITMQ=5672
NVM_PORT_RABBITMQ_UI=15672

# EMQX CỐ Ý không có biến port: nó không publish gì ra host.
# 1883 và 18083 chỉ tồn tại bên trong ot-net/dmz-net. Publish ra host mở lại
# đúng đường vòng mà K11 cấm — đo được, xem M0 §C08.4. Cần MQTT lúc dev thì
# `make dmz-shell`.

NVM_PORT_MINIO=9000
NVM_PORT_MINIO_UI=9001
NVM_PORT_KEYCLOAK=8081
NVM_PORT_GRAFANA=3000

# Host .NET chạy ngoài Docker (dotnet run), ghi ở đây cho đủ bảng
NVM_PORT_HOST_ALL=5080
NVM_PORT_EXECUTION=5081

# Mendix Studio Pro chạy local — không do compose quản lý, ghi để giữ port
NVM_PORT_MENDIX=8080

# ─────────────────────────────────────────────────────────
# Thông tin đăng nhập — thêm dần theo từng commit
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# PostgreSQL + TimescaleDB  (C06)
# Mật khẩu dev, chỉ bảo vệ container trên localhost.
# ─────────────────────────────────────────────────────────
NVM_POSTGRES_DB=novavolt
NVM_POSTGRES_USER=nvm
NVM_POSTGRES_PASSWORD=CHANGE_ME_postgres

# POM M4: role nvm_pom chỉ SELECT schema pom, khác credential migration/seed.
NVM_POM_PASSWORD=CHANGE_ME_pom_readonly

# Grafana (M3/C13) đăng nhập PostgreSQL bằng role read-only riêng. Không dùng lại
# mật khẩu writer: lộ datasource không được phép biến thành quyền sửa telemetry.
NVM_GRAFANA_ADMIN_USER=admin
NVM_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
NVM_GRAFANA_DB_PASSWORD=CHANGE_ME_grafana_readonly

# Site nao role Grafana duoc DOC — day la authorization that, khong phai filter hien thi.
# `make up-obs` ghi danh sach nay vao ts.site_read_grant; view trong schema ts_scoped loc theo
# current_user nen dashboard khong tu mo rong duoc (K3, migration 008). Nhieu site thi ngan cach
# bang dau phay. DE1 chua co telemetry formation nao o M3, nen mac dinh chi NV1.
NVM_GRAFANA_SITES=NV1

# ─────────────────────────────────────────────────────────
# SQL Server  (C07)
# Mật khẩu PHẢI đạt độ phức tạp của SQL Server: >=8 ký tự, có hoa,
# thường, số và ký tự đặc biệt. Không dùng kiểu 'nvm_dev_only' như Postgres.
# ─────────────────────────────────────────────────────────
NVM_MSSQL_SA_PASSWORD=CHANGE_ME_Sa1!
NVM_MSSQL_APP_PASSWORD=CHANGE_ME_App1!

# ─────────────────────────────────────────────────────────
# RabbitMQ + EMQX  (C08)
# EMQX yêu cầu mật khẩu dashboard >= 8 ký tự.
# ─────────────────────────────────────────────────────────
NVM_RABBITMQ_USER=nvm
NVM_RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
NVM_EMQX_USER=admin
NVM_EMQX_PASSWORD=CHANGE_ME_emqx

# ─────────────────────────────────────────────────────────
# MinIO + Keycloak  (C09)
# ─────────────────────────────────────────────────────────
NVM_MINIO_USER=nvmadmin
NVM_MINIO_PASSWORD=CHANGE_ME_minio
NVM_KEYCLOAK_ADMIN=admin
NVM_KEYCLOAK_PASSWORD=CHANGE_ME_keycloak

# ─────────────────────────────────────────────────────────
# Backup  (C11)
# `make backup` git-bundle toàn bộ repo kèm lịch sử vào đây.
# Chưa có remote nên đây là bản sao duy nhất nằm ngoài ổ D.
# ─────────────────────────────────────────────────────────
NVM_BACKUP_DIR=C:/Users/Kingc/OneDrive/backup/novavolt-mes
