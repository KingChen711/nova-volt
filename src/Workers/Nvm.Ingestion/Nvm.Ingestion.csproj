<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Điểm bắc cầu DMZ -> IT của M2. Process chỉ nhận batch đã decode qua HTTP và ghi PostgreSQL;
    nó không biết MQTT, còn gateway không biết database hay RabbitMQ (K11, K12).
  -->

  <PropertyGroup>
    <RootNamespace>Nvm.Ingestion</RootNamespace>
    <AssemblyName>Nvm.Ingestion</AssemblyName>
    <UserSecretsId>nvm-ingestion</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="dbup-postgresql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Platform/Nvm.Hosting/Nvm.Hosting.csproj" />
    <!-- Đường publish DUY NHẤT: envelope CloudEvents của M1, không dựng đường thứ hai (C14). -->
    <ProjectReference Include="../../Platform/Nvm.Bus/Nvm.Bus.csproj" />
    <ProjectReference Include="../../Platform/Nvm.Sparkplug/Nvm.Sparkplug.csproj" />
    <!-- Chỉ để đọc seed factory model: file drop phải kiểm equipment_path đúng như đường MQTT (K3). -->
    <ProjectReference Include="../../FunctionalBlocks/FactoryModel/Nvm.FactoryModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/Up/*.sql" />
    <!-- Down script là artefact review/rollback, không được DbUp nhặt vào chuỗi forward. -->
    <Content Include="Migrations/Down/*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
