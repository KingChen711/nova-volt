<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test hành vi của lớp Product trên SQL Server thật (Testcontainers). Mỗi test khẳng định một hành vi đã quan sát
    của lớp nhà cung cấp (plan §4.3); nguồn ghi ở docs/oef-mapping.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nvm.ProductTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Foundation/Nvm.Foundation/Nvm.Foundation.csproj" />
    <ProjectReference Include="../../../src/Product/Nvm.Product/Nvm.Product.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
