{
  "Name": "NvProductionExt_002_FlowModeConfigs",
  "BreakOnError": true,
  "TestDefinitions": [
    {
      "Name": "FlowModeConfig",
      "Csv": "flow-mode-configs.csv",
      "TestSteps": [
        {
          "ID": "GetFlowModeConfig",
          "StepType": "Read",
          "App": "Production",
          "Name": "OperationScrapConfig",
          "Query": {
            "$filter": "OperationCode eq '#TEST_CSV.OperationCode#' and StatusCode eq '#TEST_CSV.StatusCode#' and ScheduleNId eq '#TEST_CSV.ScheduleNId#' and IsFlowMode eq #TEST_CSV.IsFlowMode#",
            "$top": "1"
          },
          "IfThisSkipNext": true
        },
        {
          "ID": "SetFlowModeConfig",
          "StepType": "Command",
          "App": "Production",
          "Name": "NvProductionExt_SetOperationScrapConfig",
          "Parameters": {
            "NId": "#TEST_CSV.NId#",
            "OperationCode": "#TEST_CSV.OperationCode#",
            "StatusCode": "#TEST_CSV.StatusCode#",
            "ScheduleNId": "#TEST_CSV.ScheduleNId#",
            "IsFlowMode": "#TEST_CSV.IsFlowMode#",
            "AutoDispositionStatus": "#TEST_CSV.AutoDispositionStatus#",
            "DispositionOperationCode": "#TEST_CSV.DispositionOperationCode#",
            "SplitQuantity": "#TEST_CSV.SplitQuantity#",
            "SplitUnitOfMeasure": "#TEST_CSV.SplitUnitOfMeasure#",
            "ScrapCode": "#TEST_CSV.ScrapCode#",
            "ProblemCode": "#TEST_CSV.ProblemCode#",
            "ModelCode": "#TEST_CSV.ModelCode#",
            "CreatingCostCenter": "#TEST_CSV.CreatingCostCenter#",
            "ChargeToCostCenter": "#TEST_CSV.ChargeToCostCenter#"
          }
        }
      ]
    }
  ]
}
