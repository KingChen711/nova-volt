<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lớp Project: vai team dự án (FB, extension app, app nghiệp vụ). Dựng từ R4.
    Mở rộng lớp Product bằng facet, pre-check, post-action; không sửa lớp Product.
  -->

  <PropertyGroup>
    <RootNamespace>Nvm.Project</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lệnh đọc tin và handler tin máy gọi hàm của schema trung gian LineDB (R5). -->
    <PackageReference Include="Npgsql" />
    <!-- Code thành phẩm gọi stored procedure qua kết nối SQL riêng lấy từ configuration key, như code của team (R7). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Foundation/Nvm.Foundation/Nvm.Foundation.csproj" />
    <ProjectReference Include="../../Product/Nvm.Product/Nvm.Product.csproj" />
  </ItemGroup>

</Project>
