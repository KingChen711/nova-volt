<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 test projects are executables; the runner is compiled into the assembly. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Nvm.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Chỉ cần xunit.v3: nó đã nhúng sẵn Microsoft.Testing.Platform runner.
      KHÔNG thêm Microsoft.NET.Test.Sdk hay xunit.runner.visualstudio — đó là hạ tầng
      VSTest, và .NET 10 đã bỏ hỗ trợ VSTest cho MTP.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!-- FakeTimeProvider: tua đồng hồ trong test thay vì chờ thật (K1). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lịch sản xuất là hàm domain thuần: production day, ca kíp, DST. Không cần DB nào để kiểm. -->
    <ProjectReference Include="../../../src/Foundation/Nvm.Time/Nvm.Time.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
