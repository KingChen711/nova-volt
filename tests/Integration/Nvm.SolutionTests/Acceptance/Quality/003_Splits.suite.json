{
  "Name": "003_Splits",
  "BreakOnError": false,
  "TestDefinitions": [
    {
      "Name": "Q15 tin OK có cấu hình tách: MTU con .1 bị hủy, NC không mang mã 00, MTU mẹ dùng tiếp",
      "TestSteps": [
        {
          "ID": "Apply1",
          "StepType": "Command",
          "App": "Production",
          "Name": "NvProductionExt_ApplyLineResults",
          "Parameters": {
            "Operations": [
              {
                "OperationCode": "el010",
                "EquipmentCode": "el010_m1_1",
                "Serial": "AQ15-EC1",
                "StatusId": "OK",
                "StatusCode": "00",
                "EndTime": "2026-10-26T08:00:00Z",
                "Quantity": 120
              }
            ]
          },
          "Asserts": [
            {
              "Path": "NotExecutedOperations",
              "Count": 0
            }
          ]
        },
        {
          "ID": "Nc2",
          "StepType": "Command",
          "App": "Production",
          "Name": "NvProductionExt_HandleLineNonConformances",
          "Parameters": {
            "Items": "#GET->Apply1.Result.NonConformanceData#"
          },
          "Asserts": [
            {
              "Path": "NotHandled",
              "Count": 0
            }
          ]
        },
        {
          "ID": "Mtu3",
          "StepType": "Read",
          "App": "Production",
          "Name": "Mtu",
          "Query": {
            "$filter": "NId eq 'NV-WIP-ELEC-A_AQ15-EC1.1'"
          },
          "Asserts": [
            {
              "Path": "value",
              "Count": 1
            },
            {
              "Path": "value[0].Status",
              "Equals": "Scrapped"
            }
          ]
        },
        {
          "ID": "Mtu4",
          "StepType": "Read",
          "App": "Production",
          "Name": "Mtu",
          "Query": {
            "$filter": "NId eq 'NV-WIP-ELEC-A_AQ15-EC1'"
          },
          "Asserts": [
            {
              "Path": "value",
              "Count": 1
            },
            {
              "Path": "value[0].Status",
              "Equals": "Available"
            }
          ]
        },
        {
          "ID": "List5",
          "StepType": "Function",
          "App": "Production",
          "Name": "NvProductionExt_NonConformanceList",
          "Parameters": {},
          "Query": {
            "$filter": "Serial eq 'AQ15-EC1'",
            "$orderby": "StartDate,NId"
          },
          "Asserts": [
            {
              "Path": "value",
              "Count": 1
            },
            {
              "Path": "value[0].Status",
              "Equals": "SCRAP"
            },
            {
              "Path": "value[0].StatusCode",
              "Equals": null
            }
          ]
        }
      ]
    },
