{
  "Name": "MapApp_001_LineCodes",
  "BreakOnError": true,
  "TestDefinitions": [
    {
      "Name": "LineOperationCodes",
      "Csv": "line-operations.csv",
      "TestSteps": [
        {
          "ID": "GetLineOperationCode",
          "StepType": "Read",
          "App": "MapApp",
          "Name": "LineOperationCode",
          "Query": {
            "$filter": "NId eq '#TEST_CSV.NId#'",
            "$top": "1"
          },
          "IfThisSkipNext": true
        },
        {
          "ID": "SetLineOperationCode",
          "StepType": "Command",
          "App": "MapApp",
          "Name": "SetLineOperationCode",
          "Parameters": {
            "NId": "#TEST_CSV.NId#",
            "OperationNId": "#TEST_CSV.OperationNId#"
          }
        }
      ]
    },
    {
      "Name": "LineEquipmentCodes",
      "Csv": "line-equipment.csv",
      "TestSteps": [
        {
          "ID": "GetLineEquipmentCode",
          "StepType": "Read",
          "App": "MapApp",
          "Name": "LineEquipmentCode",
          "Query": {
            "$filter": "NId eq '#TEST_CSV.NId#'",
            "$top": "1"
          },
          "IfThisSkipNext": true
        },
        {
          "ID": "SetLineEquipmentCode",
          "StepType": "Command",
          "App": "MapApp",
          "Name": "SetLineEquipmentCode",
          "Parameters": {
            "NId": "#TEST_CSV.NId#",
            "EquipmentNId": "#TEST_CSV.EquipmentNId#",
            "LineNumber": "#TEST_CSV.LineNumber#"
          }
        }
      ]
    },
    {
      "Name": "LineMaterialCodes",
      "Csv": "line-materials.csv",
      "TestSteps": [
        {
          "ID": "GetLineMaterialCode",
          "StepType": "Read",
          "App": "MapApp",
          "Name": "LineMaterialCode",
          "Query": {
            "$filter": "NId eq '#TEST_CSV.NId#'",
            "$top": "1"
          },
          "IfThisSkipNext": true
        },
        {
          "ID": "SetLineMaterialCode",
          "StepType": "Command",
          "App": "MapApp",
          "Name": "SetLineMaterialCode",
          "Parameters": {
            "NId": "#TEST_CSV.NId#",
            "MaterialNId": "#TEST_CSV.MaterialNId#"
          }
        }
      ]
    }
  ]
}
