<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Functional Block ĐẦU TIÊN của dự án (khái niệm OEF, bài 9 của course).

    Quy tắc K8: FB không được reference FB khác. Trao đổi giữa các FB đi qua Nvm.Contracts
    và bus, không đi qua project reference. Ràng buộc này được ép bằng NetArchTest ở C17,
    không phải bằng việc nhớ.

    Bố cục đầy đủ của một FB (Entities/ Facets/ Commands/ Handlers/ Migrations/) được chốt ở M5.
    Ở M1, FB này mới có phần mô hình cây — đủ để bus có một event thật để chở.
  -->

  <PropertyGroup>
    <RootNamespace>Nvm.FactoryModel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contracts: event mà FB này phát ra. Đi qua contract chứ không qua reference giữa các FB (K8). -->
    <ProjectReference Include="../../Platform/Nvm.Contracts/Nvm.Contracts.csproj" />
    <!-- EquipmentPath và FactoryNodeKind sống ở Kernel: chúng là định danh dùng chung, không
         phải tài sản riêng của FB này. Xem XML doc của EquipmentPath. -->
    <ProjectReference Include="../../Platform/Nvm.Kernel/Nvm.Kernel.csproj" />
    <!--
      Nvm.Time hỏi "site này ở múi giờ nào"; FB này là nơi biết câu trả lời, vì nó sở hữu cây nhà
      máy. Chiều phụ thuộc đi một hướng: FB -> Nvm.Time, không bao giờ ngược. Ép bằng rule A8.
    -->
    <ProjectReference Include="../../Platform/Nvm.Time/Nvm.Time.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chỉ Abstractions, đủ cho AddNvmFactoryModel. FB không dựng container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
