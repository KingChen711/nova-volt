<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phía xưởng: LineDB, line simulator, relay chuyển tin. Dựng ở R5.
    Chỉ nói chuyện với MOM qua event và command của Foundation, không reference Product hay Project.
  -->

  <PropertyGroup>
    <RootNamespace>Nvm.Shopfloor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script LineDB nhúng vào assembly: installer chạy theo thứ tự tên file. -->
    <EmbeddedResource Include="LineDb/Sql/*.sql" LogicalName="LineDb.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Foundation/Nvm.Foundation/Nvm.Foundation.csproj" />
  </ItemGroup>

</Project>
