<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tầng hosting/adapter của ProductionExecution: nơi DUY NHẤT chạm SqlClient + MassTransit + ASP.NET
    cho lát cắt này, dùng chung bởi cả Nvm.App.Execution và Nvm.Host.All để hai host không lệch nhau.

    Không phải một Functional Block — nó là code wiring, nên được phép reference CommandStore/Bus. FB
    thật (Nvm.ProductionExecution) vẫn sạch theo K8/K9.
  -->

  <PropertyGroup>
    <RootNamespace>Nvm.ProductionExecution.Hosting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ProductionExecution/Nvm.ProductionExecution.csproj" />
    <ProjectReference Include="../../Platform/Nvm.CommandStore/Nvm.CommandStore.csproj" />
    <ProjectReference Include="../../Platform/Nvm.Bus/Nvm.Bus.csproj" />
    <ProjectReference Include="../../Platform/Nvm.Contracts/Nvm.Contracts.csproj" />
    <ProjectReference Include="../../Platform/Nvm.Kernel/Nvm.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

</Project>
