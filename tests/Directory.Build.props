<Project>

  <!--
    Nới một số quy tắc cho test project.
    Phải Import thủ công file cha, vì MSBuild chỉ nạp Directory.Build.props
    GẦN NHẤT tính từ project đi lên — tìm thấy file này là nó dừng.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Test code có warning vô hại thật (biến chưa dùng trong arrange, so sánh hằng...).
      Để TreatWarningsAsErrors ở đây sẽ khiến bạn viết test vòng vo cho vừa lòng
      compiler, thay vì viết test đọc dễ. Warning vẫn hiện, chỉ không chặn build.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      GenerateDocumentationFile GIỮ true (kế thừa từ root) dù test không cần XML doc.
      Lý do: đây là cờ bật IDE0005 (using thừa) lúc build; tắt nó thì Roslyn
      cảnh báo ở MỌI lần build. CS1591 (thiếu doc comment) đã tắt trong .editorconfig.
    -->

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
